{
  "info": {
    "name": "QA API Testing - JSONPlaceholder (v2.0)",
    "description": "Portfolio collection demonstrating REST API testing with Postman: positive and negative scenarios, status and content-type checks, JSON structure and type validation, response assertions, and response-time checks. Write operations are simulated by JSONPlaceholder and are not persisted.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "nonExistingUserId",
      "value": "999999"
    },
    {
      "key": "nonExistingPostId",
      "value": "999999"
    },
    {
      "key": "maxResponseTimeMs",
      "value": "2000"
    }
  ],
  "item": [
    {
      "name": "GET - Retrieve all posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "description": "Retrieves the posts collection and validates status, content type, response shape, field presence, data types, and response time."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Content-Type indicates JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
              "});",
              "pm.test('Response is a non-empty array', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an('array').that.is.not.empty;",
              "});",
              "pm.test('Each post has the expected fields and data types', function () {",
              "    const data = pm.response.json();",
              "    data.forEach(function (post) {",
              "        pm.expect(post).to.have.all.keys('userId', 'id', 'title', 'body');",
              "        pm.expect(post.userId).to.be.a('number');",
              "        pm.expect(post.id).to.be.a('number');",
              "        pm.expect(post.title).to.be.a('string');",
              "        pm.expect(post.body).to.be.a('string');",
              "    });",
              "});",
              "pm.test('Response time is below configured threshold', function () {",
              "    const threshold = Number(pm.collectionVariables.get('maxResponseTimeMs') || 2000);",
              "    pm.expect(pm.response.responseTime).to.be.below(threshold);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Retrieve post by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "description": "Retrieves one post using the postId collection variable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is a JSON object', function () { pm.expect(pm.response.json()).to.be.an('object'); });",
              "pm.test('Returned ID matches requested ID', function () {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('postId')));",
              "});",
              "pm.test('Required fields exist and have correct types', function () {",
              "    const post = pm.response.json();",
              "    pm.expect(post.userId).to.be.a('number');",
              "    pm.expect(post.title).to.be.a('string').and.not.empty;",
              "    pm.expect(post.body).to.be.a('string');",
              "});",
              "pm.test('Response time is below configured threshold', function () {",
              "    const threshold = Number(pm.collectionVariables.get('maxResponseTimeMs') || 2000);",
              "    pm.expect(pm.response.responseTime).to.be.below(threshold);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Create a post (simulated)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"QA API Testing\",\n  \"body\": \"Testing API creation with Postman\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "JSONPlaceholder simulates creation and returns a response; it does not persist the new resource."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Response echoes submitted fields', function () {",
              "    const response = pm.response.json();",
              "    const requestData = JSON.parse(pm.request.body.raw);",
              "    pm.expect(response.title).to.eql(requestData.title);",
              "    pm.expect(response.body).to.eql(requestData.body);",
              "    pm.expect(response.userId).to.eql(requestData.userId);",
              "});",
              "pm.test('Response contains a numeric ID', function () {",
              "    pm.expect(pm.response.json().id).to.be.a('number');",
              "});",
              "pm.test('Response time is below configured threshold', function () {",
              "    const threshold = Number(pm.collectionVariables.get('maxResponseTimeMs') || 2000);",
              "    pm.expect(pm.response.responseTime).to.be.below(threshold);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT - Replace a post (simulated)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated QA Test\",\n  \"body\": \"Validating resource replacement\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Simulates a full resource replacement. JSONPlaceholder does not persist the update."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response ID matches requested resource', function () {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('postId')));",
              "});",
              "pm.test('Response reflects submitted replacement fields', function () {",
              "    const response = pm.response.json();",
              "    const requestData = JSON.parse(pm.request.body.raw);",
              "    pm.expect(response.title).to.eql(requestData.title);",
              "    pm.expect(response.body).to.eql(requestData.body);",
              "    pm.expect(response.userId).to.eql(requestData.userId);",
              "});",
              "pm.test('Response time is below configured threshold', function () {",
              "    const threshold = Number(pm.collectionVariables.get('maxResponseTimeMs') || 2000);",
              "    pm.expect(pm.response.responseTime).to.be.below(threshold);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - Delete a post (simulated)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "description": "Simulates deletion. The service does not persist deletion, so a subsequent GET is not proof of a real delete."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete request returns a successful status', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 202, 204]);",
              "});",
              "pm.test('Response time is below configured threshold', function () {",
              "    const threshold = Number(pm.collectionVariables.get('maxResponseTimeMs') || 2000);",
              "    pm.expect(pm.response.responseTime).to.be.below(threshold);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Filter with unmatched userId (negative data scenario)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?userId={{nonExistingUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts?userId={{nonExistingUserId}}"
          ]
        },
        "description": "Valid request with a filter value that should match no records; validates empty-result handling."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is an empty array for an unmatched filter', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an('array').that.is.empty;",
              "});",
              "pm.test('Response time is below configured threshold', function () {",
              "    const threshold = Number(pm.collectionVariables.get('maxResponseTimeMs') || 2000);",
              "    pm.expect(pm.response.responseTime).to.be.below(threshold);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Retrieve a non-existing post (negative resource scenario)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{nonExistingPostId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{nonExistingPostId}}"
          ]
        },
        "description": "Negative scenario. Confirm the actual service behavior when executing; if the provider changes its response contract, update the expected result with evidence."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Non-existing resource is not returned as a valid post', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([404]);",
              "});",
              "pm.test('Response is not a populated post object', function () {",
              "    const body = pm.response.text();",
              "    pm.expect(body === '' || body === '{}' || pm.response.code === 404).to.be.true;",
              "});"
            ]
          }
        }
      ]
    }
  ]
}